{
  "name": "university-curriculum-app",
  "version": "1.0.0",
  "description": "Backend for the University Curriculum application using NestJS",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "watch": "tsc -w",
    "start:dev": "nest start --watch",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/main.ts",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@nestjs/axios": "^1.0.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/mongoose": "^9.2.2",
    "@nestjs/platform-express": "^9.0.0",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "mongoose": "^7.8.7",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "typescript": "^4.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@types/node": "^16.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^4.10.0"
  },
  "license": "MIT"
}
