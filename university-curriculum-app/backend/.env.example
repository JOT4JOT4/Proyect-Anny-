# MongoDB URI
# Para desarrollo local (sin Docker):
# MONGO_URI=mongodb://root:example@localhost:27017/university_curriculum?authSource=admin
# Para Docker:
MONGO_URI=mongodb://root:example@mongo:27017/university_curriculum?authSource=admin

PORT=3000
NODE_ENV=production

# Flags to enable local behavior (fall back to DB instead of external APIs)
# Set to 'true' to use local seeded data
LOCAL_AUTH=true
LOCAL_MALLAS=true